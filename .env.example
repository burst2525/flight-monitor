# ==========================================
# 航空券通知システム 環境変数設定
# ==========================================

# Amadeus API (無料登録で取得可能: https://developers.amadeus.com/ )
AMADEUS_CLIENT_ID="あなたのAmadeus_API_KEY"
AMADEUS_CLIENT_SECRET="あなたのAmadeus_API_SECRET"
AMADEUS_HOSTNAME="production"

# iPhone通知 (ntfy.sh) - config.yamlでも指定可能
NTFY_TOPIC="flight-alert-osaka-hiroki"
